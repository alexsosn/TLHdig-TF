# macOS Finder artefacts (not part of the Zenodo release)
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Conversion outputs — regenerated by programs/convert.py, not versioned
repaired/
*.tfx
.tf/

# Generated reports: the .md ones are published (the README cites them); the bulky
# per-row .tsv diagnostics are not.
reports/*.tsv
reports/*.txt

# TF's binary cache: regenerated on first load, not part of the dataset
tf/**/.tf/
*.tfx

# The generated dataset is published, but never by `git add -A`: staging it while a
# build is running has twice captured an uncompacted 124 MB morph.tf that GitHub
# rejects outright. Publish deliberately, and only once tf/<version>/BUILD-COMPLETE
# exists:   git add -f tf/
tf/

# External sign lists, read at build time for validation only.
# Mixed licences (MIT, Apache-2.0, CC BY-SA, AGPL) -- not redistributed here.
refs/
